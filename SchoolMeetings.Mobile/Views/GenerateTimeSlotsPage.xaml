<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SchoolMeetings.Mobile.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             x:Class="SchoolMeetings.Mobile.Views.GenerateTimeSlotsPage"
             x:DataType="vm:GenerateTimeSlotsViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Genera Slot per Colloqui"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <VerticalStackLayout Spacing="10">
                <Label Text="Data *" FontAttributes="Bold" FontSize="16"/>
                <Border Stroke="Gray" StrokeThickness="1" Padding="10">
                    <DatePicker Date="{Binding SelectedDate}"
                                MinimumDate="{x:Static sys:DateTime.Today}"
                                Format="dd/MM/yyyy"/>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Label Text="Orario Inizio *" FontAttributes="Bold" FontSize="16"/>
                <Border Stroke="Gray" StrokeThickness="1" Padding="10">
                    <TimePicker Time="{Binding StartTime}"
                                Format="HH:mm"/>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Label Text="Orario Fine *" FontAttributes="Bold" FontSize="16"/>
                <Border Stroke="Gray" StrokeThickness="1" Padding="10">
                    <TimePicker Time="{Binding EndTime}"
                                Format="HH:mm"/>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Label Text="Durata Slot (minuti) *" FontAttributes="Bold" FontSize="16"/>
                <Border Stroke="Gray" StrokeThickness="1" Padding="10">
                    <Picker ItemsSource="{Binding SlotDurations}"
                            SelectedItem="{Binding SelectedDuration}"
                            Title="Seleziona durata (minuti)">
                    </Picker>
                </Border>
            </VerticalStackLayout>

            <Border Stroke="#4A90E2"
                    StrokeThickness="2"
                    Padding="15">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Anteprima"
                           FontSize="16"
                           FontAttributes="Bold"/>
                    <Label Text="{Binding EstimatedSlots, StringFormat='Verranno generati {0} slot'}"
                           FontSize="14"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap"/>

            <Button Text="Genera Slot"
                    Command="{Binding GenerateSlotsCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    HeightRequest="50"
                    FontSize="18"
                    BackgroundColor="#4A90E2"
                    Margin="0,10,0,0"/>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                              IsVisible="{Binding IsBusy}"
                              HorizontalOptions="Center"/>

            <Border Stroke="Orange"
                    StrokeThickness="1"
                    Padding="15">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Informazioni"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#E65100"/>
                    <Label Text="- Gli slot generati saranno disponibili per le prenotazioni"
                           FontSize="12"
                           TextColor="#E65100"/>
                    <Label Text="- I genitori potranno prenotare solo nell'ultima ora prima dell'inizio"
                           FontSize="12"
                           TextColor="#E65100"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>