<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SchoolMeetings.Mobile.ViewModels"
             xmlns:models="clr-namespace:SchoolMeetings.Mobile.Models"
             x:Class="SchoolMeetings.Mobile.Views.MyBookingsPage"
             x:DataType="vm:MyBookingsViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*">

        <Button Grid.Row="0"
                Text="Aggiorna"
                Command="{Binding LoadBookingsCommand}"
                Margin="10"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"/>

        <CollectionView Grid.Row="1"
                       ItemsSource="{Binding Bookings}"
                       Margin="10">

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" 
                                    HorizontalOptions="Center"
                                    Spacing="15"
                                    Padding="20">
                    <Label Text="Nessuna prenotazione attiva"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>
                    <Label Text="Prenota un colloquio dalla scheda Docenti"
                           FontSize="14"
                           TextColor="Gray"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Booking">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Cancella"
                                          BackgroundColor="Red"
                                          Command="{Binding x:DataType=vm:MyBookingsViewModel, Source={RelativeSource AncestorType={x:Type vm:MyBookingsViewModel}}, Path=CancelBookingCommand}"
                                          CommandParameter="{Binding .}"/>
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border Stroke="LightGray"
                                StrokeThickness="1"
                                Padding="15"
                                Margin="0,5"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundColorLight},Dark={StaticResource CardBackgroundColorDark}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding x:DataType=vm:MyBookingsViewModel, Source={RelativeSource AncestorType={x:Type vm:MyBookingsViewModel}}, Path=ViewBookingDetailsCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>

                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">

                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding MeetingDateFormatted}"
                                       FontSize="16"
                                       FontAttributes="Bold"/>

                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding MeetingTimeFormatted}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#4A90E2"
                                       HorizontalOptions="End"/>

                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding TeacherName}"
                                       FontSize="15"
                                       Margin="0,5,0,0"/>

                                <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding Subject}"
                                       FontSize="14"
                                       TextColor="Gray"/>

                                <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding StudentName, StringFormat='Per: {0}'}"
                                       FontSize="13"
                                       TextColor="Gray"
                                       Margin="0,5,0,0"/>

                                <HorizontalStackLayout Grid.Row="4" Grid.Column="0" 
                                                      Spacing="10"
                                                      Margin="0,5,0,0">
                                    <Label Text="{Binding DurationFormatted}"
                                           FontSize="12"
                                           TextColor="Gray"/>

                                    <Border Stroke="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                                            StrokeThickness="1"
                                            Padding="5,2"
                                            BackgroundColor="Transparent">
                                        <Label Text="{Binding Status}"
                                               FontSize="11"
                                               TextColor="{Binding Status, Converter={StaticResource StatusColorConverter}}"/>
                                    </Border>
                                </HorizontalStackLayout>

                                <Label Grid.Row="4" Grid.Column="1"
                                       Text="�"
                                       FontSize="24"
                                       TextColor="Gray"
                                       VerticalOptions="Center"
                                       HorizontalOptions="End"/>

                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator Grid.Row="1"
                          IsRunning="{Binding IsBusy}"
                          IsVisible="{Binding IsBusy}"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"/>

        <Border Grid.Row="1"
                Stroke="Orange"
                StrokeThickness="1"
                Padding="10"
                Margin="10"
                BackgroundColor="#FFF3E0"
                VerticalOptions="End"
                IsVisible="{Binding HasBookings}">
            <Label Text="Swipe a destra per cancellare. Puoi cancellare fino a 30 minuti prima."
                   FontSize="12"
                   TextColor="#E65100"
                   HorizontalTextAlignment="Center"/>
        </Border>

    </Grid>

</ContentPage>