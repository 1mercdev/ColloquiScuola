<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SchoolMeetings.Mobile.ViewModels"
             x:Class="SchoolMeetings.Mobile.Views.CleanupPage"
             x:DataType="vm:CleanupViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20" VerticalOptions="Center">

            <Label Text="Pulizia Database"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <Border Stroke="Orange"
                    StrokeThickness="2"
                    Padding="20"
                    BackgroundColor="#FFF3E0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Questa operazione eliminerà:"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#E65100"/>
                    <Label Text="- Tutte le prenotazioni completate o cancellate"
                           FontSize="14"
                           TextColor="#E65100"/>
                    <Label Text="- Tutti gli slot temporali passati non prenotati"
                           FontSize="14"
                           TextColor="#E65100"/>
                    <Label Text="- L'operazione NON può essere annullata"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="Red"
                           Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Border>

            <Border Stroke="#4A90E2"
                    StrokeThickness="2"
                    Padding="20"
                    IsVisible="{Binding HasResult}">
                <Label Text="{Binding ResultMessage}"
                       FontSize="14"
                       LineBreakMode="WordWrap"/>
            </Border>

            <Button Text="Avvia Pulizia"
                    Command="{Binding CleanupCommand}"
                    BackgroundColor="Red"
                    TextColor="White"
                    FontSize="18"
                    HeightRequest="60"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    Margin="0,20,0,0"/>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                              IsVisible="{Binding IsBusy}"
                              HorizontalOptions="Center"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>