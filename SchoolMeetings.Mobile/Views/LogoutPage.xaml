<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SchoolMeetings.Mobile.ViewModels"
             x:Class="SchoolMeetings.Mobile.Views.LogoutPage"
             x:DataType="vm:LogoutViewModel"
             Title="Logout">

    <VerticalStackLayout 
        VerticalOptions="Center" 
        HorizontalOptions="Center"
        Spacing="20"
        Padding="30">

        <Label Text="Vuoi uscire?"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalOptions="Center"/>

        <Button Text="Logout"
                Command="{Binding LogoutCommand}"
                BackgroundColor="Red"
                TextColor="White"
                WidthRequest="200"
                Margin="0,20,0,0"/>

        <ActivityIndicator IsRunning="{Binding IsBusy}"
                          IsVisible="{Binding IsBusy}"/>

    </VerticalStackLayout>

</ContentPage>