<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SchoolMeetings.Mobile.ViewModels"
             xmlns:models="clr-namespace:SchoolMeetings.Mobile.Models"
             x:Class="SchoolMeetings.Mobile.Views.ManageTeachersPage"
             x:DataType="vm:ManageTeachersViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,Auto,*">

        <Button Grid.Row="0"
                Text="Aggiorna"
                Command="{Binding LoadTeachersCommand}"
                Margin="10"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"/>

        <Button Grid.Row="1"
                Text="+ Aggiungi Docente"
                Command="{Binding AddTeacherCommand}"
                Margin="10,0"
                BackgroundColor="#FFA647"/>

        <CollectionView Grid.Row="2"
                       ItemsSource="{Binding Teachers}"
                       Margin="10">

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" 
                                    HorizontalOptions="Center"
                                    Spacing="15"
                                    Padding="20">
                    <Label Text="Nessun docente registrato"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>
                    <Label Text="Clicca 'Aggiungi Docente' per crearne uno"
                           FontSize="14"
                           TextColor="Gray"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Teacher">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Elimina"
                                          BackgroundColor="Red"
                                          Command="{Binding x:DataType=vm:ManageTeachersViewModel, Source={RelativeSource AncestorType={x:Type vm:ManageTeachersViewModel}}, Path=DeleteTeacherCommand}"
                                          CommandParameter="{Binding .}"/>
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border Stroke="LightGray"
                                StrokeThickness="1"
                                Padding="13"
                                Margin="2.8">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">

                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding FullName}"
                                       FontSize="18"
                                       FontAttributes="Bold"/>

                                <Label Grid.Row="1" Grid.Column="0"
                                       Text="{Binding Subject}"
                                       FontSize="14"
                                       TextColor="Gray"/>

                                <Label Grid.Row="2" Grid.Column="0"
                                       Text="{Binding Email}"
                                       FontSize="12"
                                       TextColor="Gray"/>

                                <Button Grid.Row="3" Grid.Column="0"
                                        Text="Modifica"
                                        Command="{Binding x:DataType=vm:ManageTeachersViewModel, Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditTeacherCommand}"
                                        CommandParameter="{Binding .}"
                                        FontSize="12"
                                        Padding="10,5"
                                        BackgroundColor="#4A90E2"
                                        Margin="0,10,0,0"/>

                                <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                        Stroke="{Binding IsAvailable, Converter={StaticResource BoolToColorConverter}}"
                                        StrokeThickness="2"
                                        Padding="8,4"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding IsAvailable, Converter={StaticResource BoolToStatusConverter}}"
                                           FontSize="11"
                                           TextColor="{Binding IsAvailable, Converter={StaticResource BoolToColorConverter}}"
                                           FontAttributes="Bold"/>
                                </Border>

                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator Grid.Row="2"
                          IsRunning="{Binding IsBusy}"
                          IsVisible="{Binding IsBusy}"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"/>

    </Grid>

</ContentPage>