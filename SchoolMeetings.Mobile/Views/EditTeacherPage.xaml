<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SchoolMeetings.Mobile.ViewModels"
             x:Class="SchoolMeetings.Mobile.Views.EditTeacherPage"
             x:DataType="vm:EditTeacherViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Nome *" FontAttributes="Bold" FontSize="14"/>
            <Border Stroke="Gray" StrokeThickness="1" Padding="10">
                <Entry Placeholder="Nome"
                       Text="{Binding FirstName}"
                       ClearButtonVisibility="WhileEditing"/>
            </Border>

            <Label Text="Cognome *" FontAttributes="Bold" FontSize="14"/>
            <Border Stroke="Gray" StrokeThickness="1" Padding="10">
                <Entry Placeholder="Cognome"
                       Text="{Binding LastName}"
                       ClearButtonVisibility="WhileEditing"/>
            </Border>

            <Label Text="Telefono (opzionale)" FontAttributes="Bold" FontSize="14"/>
            <Border Stroke="Gray" StrokeThickness="1" Padding="10">
                <Entry Placeholder="Telefono"
                       Text="{Binding Phone}"
                       Keyboard="Telephone"
                       ClearButtonVisibility="WhileEditing"/>
            </Border>

            <Label Text="Materia *" FontAttributes="Bold" FontSize="14"/>
            <Border Stroke="Gray" StrokeThickness="1" Padding="10">
                <Entry Placeholder="Es: Matematica, Italiano"
                       Text="{Binding Subject}"
                       ClearButtonVisibility="WhileEditing"/>
            </Border>

            <Label Text="Aula (opzionale)" FontAttributes="Bold" FontSize="14"/>
            <Border Stroke="Gray" StrokeThickness="1" Padding="10">
                <Entry Placeholder="Es: A12, Lab 3"
                       Text="{Binding Classroom}"
                       ClearButtonVisibility="WhileEditing"/>
            </Border>

            <HorizontalStackLayout Spacing="10">
                <Label Text="Docente Attivo" 
                       FontAttributes="Bold" 
                       FontSize="14"
                       VerticalOptions="Center"/>
                <Switch IsToggled="{Binding IsAvailable}"/>
            </HorizontalStackLayout>

            <Label Text="Note (opzionale)" FontAttributes="Bold" FontSize="14"/>
            <Border Stroke="Gray" StrokeThickness="1" Padding="10">
                <Editor Placeholder="Note aggiuntive..."
                        Text="{Binding Notes}"
                        HeightRequest="80"
                        AutoSize="TextChanges"/>
            </Border>

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,20,0,0">
                <Button Grid.Column="0"
                        Text="Annulla"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="Gray"/>

                <Button Grid.Column="1"
                        Text="Salva"
                        Command="{Binding SaveCommand}"
                        BackgroundColor="#4A90E2"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"/>
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                              IsVisible="{Binding IsBusy}"
                              HorizontalOptions="Center"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>